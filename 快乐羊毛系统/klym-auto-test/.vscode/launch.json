{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pytest: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v", "--tb=short"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "pytest: 全部 API 用例",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["api/", "-v", "--tb=short"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "pytest: 全部 UI 用例",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["ui/", "-v", "--tb=short", "--headed"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "pytest: P0 冒烟测试",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-m", "p0 and smoke", "-v"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "pytest: 分佣模块",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-m", "commission", "-v"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "pytest: 生成 HTML 报告",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [".", "-v", "--html=reports/report.html", "--self-contained-html"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
