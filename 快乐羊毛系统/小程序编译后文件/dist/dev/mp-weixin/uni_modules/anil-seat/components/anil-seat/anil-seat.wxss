/* 网格布局 */
/* 弹性盒子 */
/* 绝对定位 */
.sel-seat {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
}
.sel-seat .seat-head {
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  padding: 20rpx 30rpx;
  position: relative;
  z-index: 5;
}
.sel-seat .fix-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  width: 100%;
  z-index: 1;
  padding: 20rpx;
}
.sel-seat .fix-tips .v-tips {
  display: flex;
  align-items: center;
  color: #999;
  margin: 0 10rpx;
}
.sel-seat .fix-tips .v-tips .text {
  margin-left: 10rpx;
}
.sel-seat .seat-main {
  width: 100%;
  height: 100%;
  position: relative;
  padding: 10rpx;
}
.sel-seat .seat-main .vm-area {
  width: 750rpx;
  overflow: hidden;
  height: calc(100% - 40rpx);
}
.sel-seat .seat-main .sm-title {
  background-color: #dddddd;
  width: 380rpx;
  height: 34rpx;
  transform: perspective(34rpx) rotateX(-10deg);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}
.sel-seat .seat-main .sm-title .text {
  font-size: 24rpx;
  color: #333333;
}
.sel-seat .seat-main .sm-screen {
  width: 100rpx;
  height: 30rpx;
  border: 1rpx solid #cccccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 48rpx auto 0;
  border-radius: 4rpx;
  position: relative;
  z-index: 1;
}
.sel-seat .seat-main .sm-screen .text {
  font-size: 20rpx;
  color: #999999;
}
.sel-seat .seat-main .sm-line-center {
  height: 610rpx;
  width: 0;
  border: 1rpx dashed #e5e5e5;
  position: fixed;
  left: 50%;
  top: 0;
  display: block;
  z-index: 0;
  transform: translateX(-50%);
}
.sel-seat .seat-main .sm-cell {
  display: flex;
  margin-top: 20rpx;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}
.sel-seat .seat-main .sm-cell .sm-icon {
  width: 100%;
  height: 100%;
}
.sel-seat .seat-main .sm-line-index {
  position: fixed;
  top: 114rpx;
  left: 20rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 20rpx;
  width: 30rpx;
}
.sel-seat .seat-main .sm-line-index .text {
  font-size: 24rpx;
  color: #ffffff;
  width: 100%;
  text-align: center;
  margin-top: 20rpx;
}
.sel-seat .seat-foot-mask {
  width: 93%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
}
.sel-seat .seat-foot-mask .seat-foot {
  margin-top: auto;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  position: relative;
  z-index: 5;
  border-radius: 20px;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend, .sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect {
  display: flex;
  flex-direction: column;
  padding-bottom: 10rpx;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .text {
  font-size: 28rpx;
  color: #666666;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-recommend-header {
  display: flex;
  justify-content: space-between;
  flex-direction: column;
  margin: 15rpx 0;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-recommend-header .sh-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-recommend-header .sh-info {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
  margin: 15rpx 0;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-recommend-content {
  display: flex;
  justify-content: space-between;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-recommend-content .sfr-tag {
  background-color: #fff9e7;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 10px;
  width: 73px;
  height: 47px;
  margin: 5px 13px 0 0;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-recommend-content .sfr-tag .text {
  font-size: 24rpx;
  color: #000;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .price {
  font-size: 24rpx;
  color: red;
  margin-right: 6rpx;
  font-weight: 700;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .scr-wrap {
  display: flex;
  white-space: nowrap;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .sfr-selt {
  min-width: 130rpx;
  height: 94rpx;
  border-radius: 4rpx;
  display: flex;
  justify-content: center;
  flex-direction: column;
  margin-left: 20rpx;
  position: relative;
  margin-left: 20rpx;
  padding-left: 10rpx;
  background-color: #fff9e7;
  justify-content: center;
  border-radius: 10px;
  margin: 5px 13px 0 0;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .sfr-selt .zuowei-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .sfr-selt .zuowei-wrap .zuowei {
  font-size: 24rpx;
  font-weight: 700;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .sfr-selt .zuowei-wrap .text {
  font-size: 20rpx;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .sfr-selt .zuowei-wrap .sfr-close {
  position: absolute;
  right: 6rpx;
  top: 10rpx;
  font-size: 20rpx;
  color: #999;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .sfr-selt .sfr-close-img {
  width: 24rpx;
  height: 24rpx;
  position: absolute;
  right: 0rpx;
  top: 0rpx;
  font-size: 20rpx;
  color: #999;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect {
  /* 自定义指示器样式 */
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .scroll-indicator-container {
  display: flex;
  justify-content: center;
  width: 100%;
  padding-top: 15rpx;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .scroll-indicator-bar {
  width: 60rpx; /* 指示器槽的总宽度 */
  height: 6rpx;
  background-color: #e8e8e8;
  border-radius: 10rpx;
  position: relative;
  overflow: hidden;
}
.sel-seat .seat-foot-mask .seat-foot .sf-recommend .sf-arselect .scroll-indicator-active {
  width: 30rpx; /* 滑块的宽度 */
  height: 100%;
  background-color: #ff471f; /* 橙红色 */
  border-radius: 10rpx;
  position: absolute;
  top: 0;
  transition: left 0.1s linear;
}
.sel-seat .seat-foot-mask .f-btn {
  background-color: #ff471f;
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  border-radius: 50rpx;
  width: 100%;
  margin: 15px 0 20px 0;
}
.sel-seat .seat-foot-mask .f-btn .text {
  color: #ffffff;
  font-size: 36rpx;
}
.sel-seat .seat-foot-mask .f-btn.disabled {
  opacity: 0.8;
}
.sel-seat .seat-foot-mask .f-btn.disabled:active {
  background-color: #f45664;
}
.sel-seat .seat-foot-mask .f-btn:active {
  background-color: #de4e5d;
}