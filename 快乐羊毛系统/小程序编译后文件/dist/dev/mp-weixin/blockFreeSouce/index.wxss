/* 绝对定位 */
.freeSouce .search {
  width: 90%;
  height: 3.5vh;
  margin: 20rpx auto 0;
  background: #e0e0e0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding-left: 28rpx;
  box-sizing: border-box;
  margin-bottom: 1vh;
}
.freeSouce .search .placeholder {
  font-size: 24rpx;
  color: #9e9e9e;
}
.freeSouce .sourceContent {
  display: flex;
  box-sizing: border-box;
}
.freeSouce .sourceContent .type {
  width: 80rpx;
  height: 80rpx;
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 10rpx;
}
.freeSouce .sourceContent image {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 10rpx;
  background: #eee;
}
.freeSouce .sourceContent .right {
  margin-left: 20rpx;
  width: 380rpx;
}
.freeSouce .sourceContent .right .title {
  font-size: 28rpx;
  color: #343434;
  font-weight: bold;
}
.freeSouce .sourceContent .right .desc {
  font-size: 20rpx;
  color: #878787;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-top: 10rpx;
}
.freeSouce .sourceContent .right .btnGroup {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}
.freeSouce .sourceContent .right .btnGroup .btn {
  font-size: 22rpx;
  padding: 6rpx 24rpx;
  color: #fff;
  background: #e5b061;
  border-radius: 50rpx;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}