}
.movie-card .refund-tips .tip-item .ljzf.data-v-7f5281b4 {
  background: #ff471f;
  color: #fff;
  border: 1rpx solid #ff471f;
}
.movie-card.data-v-7f5281b4 {
  /* 锯齿圆点效果 */
}
.movie-card .zuoyuan.data-v-7f5281b4,
