.movie-card .zfzt.data-v-7f5281b4 {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.movie-card .zfzt .dorder.data-v-7f5281b4 {
  font-size: 24rpx;
  font-weight: 600;
  color: #ff471f;
}
.movie-card .zfzt .dorder.status-gray.data-v-7f5281b4 {
  color: #999;
}
.movie-card .zfzt .cinema-name.data-v-7f5281b4 {
  font-size: 24rpx;
  color: #333;
}
.movie-card .movie-info.data-v-7f5281b4 {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin: 20rpx 0 30rpx 0;
}
.movie-card .dyimg.data-v-7f5281b4 {
  height: 180rpx;
  width: 130rpx;
  flex-shrink: 0;
}
.movie-card .dyimg .poster.data-v-7f5281b4 {
  width: 100%;
  height: 100%;
