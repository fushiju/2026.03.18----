}
.movie-card .refund-tips.data-v-7f5281b4 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f1f1f1;
}
.movie-card .refund-tips .price.data-v-7f5281b4 {
  font-size: 32rpx;
  color: #222;
  font-weight: bold;
}
.movie-card .refund-tips .tip-item.data-v-7f5281b4 {
